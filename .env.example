# Application Settings
ENVIRONMENT=development
APP_NAME="LoadOpt — Smart Truck Loading and Delivery Optimization"
DEBUG=True

# Security
SECRET_KEY=loadopt-super-secret-development-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Local SQLite (Development default):
DATABASE_URL=sqlite:///./loadopt.db

# Azure SQL Database (Production configuration example):
# DATABASE_URL=mssql+pyodbc://loadoptadmin:YourStrongPassword123!@loadopt-sql-server.database.windows.net:1433/loadopt-db?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no&Connection+Timeout=30

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
